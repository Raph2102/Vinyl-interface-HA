# Copie ce fichier en ".env" (sans le .example) et remplis les 2 lignes.
#
# HA_URL : l'adresse de ton Home Assistant, SANS slash final.
#          Exemples : http://homeassistant.local:8123
#                     http://192.168.1.42:8123
#
# HA_TOKEN : un "jeton d'acces longue duree".
#          Dans Home Assistant : clic sur ton nom (en bas a gauche)
#          -> onglet "Securite" -> tout en bas "Jetons d'acces longue duree"
#          -> "Creer un jeton" -> nomme-le "MD Vinyl" -> copie la longue chaine.
#          (Elle ne s'affiche qu'une seule fois.)

HA_URL=http://homeassistant.local:8123
HA_TOKEN=colle_ton_token_ici
